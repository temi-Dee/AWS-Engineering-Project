{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyCreateWithoutTags",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "rds:CreateDBInstance",
        "s3:CreateBucket",
        "lambda:CreateFunction"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotLike": {
          "aws:RequestTag/Environment": ["production", "staging", "development"],
          "aws:RequestTag/Team": "*",
          "aws:RequestTag/Application": "*",
          "aws:RequestTag/CostCenter": "*"
        }
      }
    }
  ]
}
